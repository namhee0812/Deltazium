<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.deltazium.backend.events.TableEventRepository">

    <resultMap id="tableEvent" type="io.deltazium.backend.events.TableEvent">
        <constructor>
            <idArg column="id" javaType="long"/>
            <arg column="occurred_at" javaType="java.time.LocalDateTime"/>
            <arg column="schema_name" javaType="String"/>
            <arg column="table_name" javaType="String"/>
            <arg column="event_type" javaType="String"/>
            <arg column="severity" javaType="String"/>
            <arg column="message" javaType="String"/>
            <arg column="detail" javaType="String"/>
        </constructor>
    </resultMap>

    <select id="findRecent" resultMap="tableEvent">
        SELECT * FROM table_events ORDER BY id DESC LIMIT #{limit}
    </select>

    <select id="findByTable" resultMap="tableEvent">
        SELECT * FROM table_events
         WHERE schema_name = #{schema} AND table_name = #{table}
         ORDER BY id DESC LIMIT #{limit}
    </select>

    <insert id="insertEvent">
        INSERT INTO table_events (schema_name, table_name, event_type, severity, message, detail)
        VALUES (#{schema}, #{table}, #{eventType}, #{severity}, #{message}, #{detail})
    </insert>

</mapper>
