# 저장소 프로파일 로컬 오버라이드 예시 (TODO ③, architecture.md 2.2·3절)
#
# 사용법: 이 파일을 deploy/env.local.sh로 복사(git-ignore 대상 — 토큰 등 비밀값이 들어간다)해
# 값을 채우고, deploy/env.sh가 마지막에 자동으로 source한다. minio 프로파일(기본)만 쓸 거면
# 이 파일을 만들지 않아도 된다.
#
# R2 준비 절차 (Cloudflare 대시보드, 2026-09-07 공식 문서 기준):
#   1. R2 버킷 생성 (DZ_R2_BUCKET에 쓸 이름).
#   2. 그 버킷에서 "R2 Data Catalog" 활성화 — 활성화 화면이 카탈로그 URI(DZ_R2_CATALOG_URI)와
#      warehouse 표시값(DZ_R2_WAREHOUSE, 보통 버킷 이름과 동일)을 보여준다. 그대로 옮겨 적을 것.
#   3. API 토큰 발급: "R2" + "R2 Data Catalog" 권한 "Admin Read & Write"(읽기 전용 클라이언트는
#      "Admin Read only")로 발급 → DZ_R2_TOKEN.
#   4. S3 엔드포인트는 계정 ID 기반 고정 형식 — https://<account_id>.r2.cloudflarestorage.com.
#   5. DZ_R2_ACCESS_KEY/SECRET_KEY는 기본적으로 불필요하다 — R2 Data Catalog가 S3 자격을
#      위임한다(vended credentials). 위임이 안 되는 클라이언트를 붙일 일이 생기면 R2 API
#      토큰(S3 호환)을 별도 발급해 채운다.
#
# 전환 절차(정지 상태 필요, docs/operations.md "프로파일 전환 절차" 참고): 전체 정지 →
# 등록 테이블 해제(changelog 보존) → 이 값들로 재기동 → 재등록(재스냅샷). MinIO의 기존
# changelog는 남고, 전환 후 새 changelog는 R2에 쌓인다 — 자동 이전 없음.

export DZ_STORAGE_PROFILE=r2

export DZ_R2_CATALOG_URI="https://api.cloudflarestorage.com/xxxxxxxx/r2-catalog/yyyyyyyy"
export DZ_R2_WAREHOUSE="my-bucket"
export DZ_R2_BUCKET="my-bucket"
export DZ_R2_TOKEN="여기에_R2_API_토큰"
export DZ_R2_S3_ENDPOINT="https://xxxxxxxx.r2.cloudflarestorage.com"

# 선택 — 자격 위임이 안 되는 경우에만 채운다 (기본은 미지정 권장)
# export DZ_R2_ACCESS_KEY="..."
# export DZ_R2_SECRET_KEY="..."
