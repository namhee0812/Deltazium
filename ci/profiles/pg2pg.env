# E2E 프로파일: PostgreSQL 소스 → PostgreSQL 타깃 (기본 프로파일)
#
# 셸 변수 파일이다 — ci/e2e-cdc.sh가 `source`로 읽는다 (deploy/env.sh와 같은 방식).
# "어디에 접속하는가"만 둔다. 비밀번호는 여기에 쓰지 않는다 (리포에 포함되는 파일이므로):
#   - CI: GitLab Settings → CI/CD → Variables(Masked)의 SRC_PASSWORD / TGT_PASSWORD
#   - 수동 실행: ci/local.env (git-ignore, ci/local.env.example 참고)
#
# *_USER 는 backend에 등록하는 연결(Debezium 캡처·JDBC sink)의 계정이다.
# (스키마 준비·정리용 관리 계정은 DB 어댑터 ci/lib/db-pg.sh가 deploy/env.sh의 DZ_PG_USER로 따로 쓴다)

SRC_DB_TYPE=POSTGRESQL      # ci/lib/db-<소문자 타입>.sh 어댑터를 고른다 (postgresql → db-pg.sh)
SRC_HOST=127.0.0.1
SRC_PORT=5433
SRC_DB=deltazium
SRC_USER=dz_capture

TGT_DB_TYPE=POSTGRESQL
TGT_HOST=127.0.0.1
TGT_PORT=5433
TGT_DB=deltazium
TGT_USER=dz_capture

SNAPSHOT_MODE=INITIAL
